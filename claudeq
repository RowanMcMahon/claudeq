#!/bin/sh
# claudeq: throwaway one-shot Claude Code questions, answered straight into the terminal.
# Installed as `claudeq` plus symlinks (claudeqs, claudeql4, ...); the name it's run as picks
# the model and effort: claudeq[model][effort]
#   model:  s=haiku  m=sonnet  l=opus             (default: s)
#   effort: 1=low  2=medium  3=high  4=xhigh  5=max  (default: 1)
set -eu

version=1.1.0
me=$(basename "$0")

usage() {
  cat <<EOF
usage: $me [-m s|m|l|MODEL] [-e 1-5|LEVEL] [--] QUESTION...
       ... | $me [QUESTION...]
       $me --uninstall [--yes]

One-shot Claude Code question: no saved session, web search allowed, and the
answer formatted for a plain terminal. Words are joined, so quotes are optional
(but quote anything your shell would expand, like ? or *).

Variants: claudeq[s|m|l][1-5], e.g. claudeqs, claudeql4, claudeq3
  model   s=haiku  m=sonnet  l=opus                  (default s)
  effort  1=low  2=medium  3=high  4=xhigh  5=max    (default 1)
-m and -e override the variant's defaults.
EOF
}
say() { printf '%s\n' "$*"; }
die() { printf '%s: %s\n' "$me" "$*" >&2; exit 2; }

# Remove this install: the program, its variant links, update backups, and the PATH line
# install.sh added (kept if other programs share the directory). Asks first unless --yes.
uninstall() {
  yes=0
  case ${1:-} in
    -y|--yes) yes=1 ;;
    '') ;;
    *) die "unknown option $1 for --uninstall" ;;
  esac

  dir=$(cd "$(dirname "$0")" && pwd)
  main="$dir/claudeq"
  [ ! -f "$dir/install.sh" ] || die "$dir is the source copy, not an install; run the installed claudeq --uninstall"
  [ -f "$main" ] || die "can't find the installed program at $main"

  links=0 backups=0 others=0
  for f in "$dir"/* "$dir"/.[!.]*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    if [ -L "$f" ] && [ "$(readlink "$f")" = claudeq ]; then
      links=$((links + 1))
    else
      case $(basename "$f") in
        claudeq) ;;
        claudeq.bak-*) backups=$((backups + 1)) ;;
        *) others=$((others + 1)) ;;
      esac
    fi
  done

  marker="# claudeq: add $dir to PATH"
  rcs=""
  for rc in "${ZDOTDIR:-$HOME}/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.bash_login" \
            "$HOME/.profile" "${XDG_CONFIG_HOME:-$HOME/.config}/fish/conf.d/claudeq.fish"; do
    if [ -f "$rc" ] && grep -qxF "$marker" "$rc"; then
      rcs="$rcs$rc
"
    fi
  done

  say "This will remove:"
  say "  $main"
  [ "$links" -eq 0 ] || say "  $links variant links to it in $dir (claudeqs, claudeql4, ...)"
  [ "$backups" -eq 0 ] || say "  $backups old copies saved by updates ($dir/claudeq.bak-*)"
  printf '%s' "$rcs" | while IFS= read -r rc; do
    if [ "$others" -gt 0 ]; then
      say "Keeping the PATH line in $rc, since $others other program(s) in $dir may rely on it."
    elif [ "$(basename "$rc")" = claudeq.fish ]; then
      say "  $rc (created by claudeq's installer)"
    else
      say "  the PATH line claudeq's installer added to $rc (backed up first)"
    fi
  done

  if [ "$yes" -eq 0 ]; then
    # Ask on the terminal itself, so this works even when stdin is a pipe
    ( : </dev/tty ) 2>/dev/null || die "no terminal to confirm on; re-run with --uninstall --yes"
    printf 'Uninstall claudeq? [y/N] ' >/dev/tty
    read -r answer </dev/tty || answer=""
    case $answer in
      y|Y|yes|YES|Yes) ;;
      *) say "cancelled, nothing removed"; exit 1 ;;
    esac
  fi

  for f in "$dir"/claudeq*; do
    if [ -L "$f" ] && [ "$(readlink "$f")" = claudeq ]; then rm -f "$f"; fi
  done
  rm -f "$dir"/claudeq.bak-*

  if [ "$others" -eq 0 ]; then
    printf '%s' "$rcs" | while IFS= read -r rc; do
      tmp="$rc.claudeq-tmp.$$"
      # Drop the marker, the line after it, and the blank line install.sh put before it
      awk -v m="$marker" '
        skip { skip = 0; next }
        $0 == m { if (held && prev != "") print prev; held = 0; skip = 1; next }
        { if (held) print prev; prev = $0; held = 1 }
        END { if (held) print prev }
      ' "$rc" > "$tmp"
      if [ "$(basename "$rc")" = claudeq.fish ] && ! grep -q '[^[:space:]]' "$tmp"; then
        rm -f "$rc" "$tmp"   # installer-created file with nothing else in it
        say "removed $rc"
      else
        backup="$rc.claudeq-bak-$(date +%Y%m%d%H%M%S)"
        cp "$rc" "$backup"
        cat "$tmp" > "$rc"   # write in place, so a symlinked rc file stays a symlink
        rm -f "$tmp"
        say "removed the PATH line from $rc (previous version saved to $backup)"
      fi
    done
  fi

  # The shell already has this script open, so deleting it mid-run is safe
  rm -f "$main"
  say "claudeq uninstalled. open a new terminal to drop it from your shell's command cache."
}

# Defaults come from the name we were run as, e.g. claudeql4 -> opus, xhigh
model=haiku effort=low
set_model() {
  case $1 in
    s) model=haiku ;;
    m) model=sonnet ;;
    l) model=opus ;;
    ?*) model=$1 ;;  # any model name or alias claude accepts
    *) die "missing model" ;;
  esac
}
set_effort() {
  case $1 in
    1) effort=low ;;
    2) effort=medium ;;
    3) effort=high ;;
    4) effort=xhigh ;;
    5) effort=max ;;
    low|medium|high|xhigh|max) effort=$1 ;;
    *) die "unknown effort '$1' (use 1-5 or low|medium|high|xhigh|max)" ;;
  esac
}
case $me in
  claudeq*)
    v=${me#claudeq}
    case $v in
      [sml]*) set_model "${v%"${v#?}"}"; v=${v#?} ;;
    esac
    case $v in
      '') ;;
      [1-5]) set_effort "$v" ;;
      *) die "unrecognised variant name (expected claudeq[s|m|l][1-5])" ;;
    esac
    ;;
esac

while [ $# -gt 0 ]; do
  case $1 in
    -m) [ $# -ge 2 ] || die "-m needs a value"; set_model "$2"; shift 2 ;;
    -e) [ $# -ge 2 ] || die "-e needs a value"; set_effort "$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "claudeq $version"; exit 0 ;;
    --uninstall) shift; uninstall "$@"; exit 0 ;;
    --) shift; break ;;
    -?*) die "unknown option $1 (see $me --help)" ;;
    *) break ;;
  esac
done

# No question and nothing piped in: nothing to ask
if [ $# -eq 0 ] && [ -t 0 ]; then
  usage >&2
  exit 2
fi

# COLUMNS isn't exported to child processes, so ask the terminal directly
cols=${COLUMNS:-}
case $cols in
  ''|*[!0-9]*) cols=$( { stty size </dev/tty; } 2>/dev/null | cut -d' ' -f2 ) ;;
esac
case $cols in
  ''|*[!0-9]*|0) cols=80 ;;
esac

# Double-quoted: avoid backticks and $ in this text, the shell would expand them
prompt="Your response is printed raw to a terminal by a one-shot shell command, not shown in the Claude Code UI. Markdown is not rendered: do not use headings, bold, italics, code fences or backticks. Use plain text, short paragraphs, '-' bullets and indented code. Draw tables, charts and graphs with Unicode box-drawing and block characters (e.g. ┌─┬┐│├┼┤└┴┘ ▁▂▃▄▅▆▇█), laid out on a monospace grid: pad every cell so columns line up and rows are the same width, and avoid emoji or other double-width characters. The terminal is $cols columns wide: keep tables and charts within that width and print them directly, never inside a fenced code block (prose can wrap naturally). The user cannot reply, so do not ask follow-up questions; answer directly and concisely."

# Join the words into one question; with none, claude reads it from stdin
[ $# -gt 0 ] && set -- "$*"

exec claude --allowedTools=WebSearch,WebFetch --print --no-session-persistence \
  --model="$model" --effort="$effort" --append-system-prompt="$prompt" "$@"
